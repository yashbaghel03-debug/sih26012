#!/usr/bin/env bash
set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

PYTHON_BIN="${PYTHON_BIN:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  PYTHON_BIN="python"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required but was not found in PATH. Please install Docker Desktop or Docker Engine first."
  exit 1
fi

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "Python was not found in PATH."
  exit 1
fi

echo "[1/5] Ensuring Python dependencies are installed..."
"$PYTHON_BIN" -m pip install -r requirements.txt >/tmp/sih26012_pip.log 2>&1 || {
  echo "Dependency installation failed. See /tmp/sih26012_pip.log"
  exit 1
}

echo "[2/5] Starting PostGIS..."
docker compose up -d postgis >/tmp/sih26012_docker.log 2>&1 || {
  echo "Docker compose failed. See /tmp/sih26012_docker.log"
  exit 1
}

for _ in $(seq 1 60); do
  if docker ps --format '{{.Names}}' | grep -q 'sih26012-postgis'; then
    break
  fi
  sleep 1
done

if ! docker ps --format '{{.Names}}' | grep -q 'sih26012-postgis'; then
  echo "PostGIS did not start successfully."
  exit 1
fi

echo "[3/5] Importing India boundary data (best effort)..."
if "$PYTHON_BIN" -m backend.postgis.import_india_admin >/tmp/sih26012_import.log 2>&1; then
  echo "Boundary import succeeded."
else
  echo "Boundary import failed, but the app has a built-in fallback and will continue."
fi

echo "[4/5] Starting FastAPI backend..."
nohup "$PYTHON_BIN" -m uvicorn backend.api.main:app --host 0.0.0.0 --port 8000 >/tmp/sih26012_backend.log 2>&1 &

for _ in $(seq 1 60); do
  if curl -fsS http://localhost:8000/health >/tmp/sih26012_backend_check.out 2>/dev/null; then
    break
  fi
  sleep 1
done

if ! curl -fsS http://localhost:8000/health >/tmp/sih26012_backend_check.out 2>/dev/null; then
  echo "FastAPI did not start successfully. See /tmp/sih26012_backend.log"
  exit 1
fi

echo "[5/5] Starting frontend server..."
nohup "$PYTHON_BIN" serve_frontend.py --port 3000 >/tmp/sih26012_frontend.log 2>&1 &

for _ in $(seq 1 40); do
  if curl -fsSI http://localhost:3000/map.html >/tmp/sih26012_frontend_check.out 2>/dev/null; then
    break
  fi
  sleep 1
done

if ! curl -fsSI http://localhost:3000/map.html >/tmp/sih26012_frontend_check.out 2>/dev/null; then
  echo "Frontend did not start successfully. See /tmp/sih26012_frontend.log"
  exit 1
fi

cat <<EOF

Project started successfully.

Open in your browser:
  http://localhost:3000/map.html

API health check:
  http://localhost:8000/health

Logs:
  /tmp/sih26012_backend.log
  /tmp/sih26012_frontend.log

To stop the app later, run:
  pkill -f 'uvicorn backend.api.main:app'
  pkill -f 'serve_frontend.py'
EOF
