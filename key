#!/usr/bin/env bash
set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

PYTHON_BIN="${PYTHON_BIN:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  PYTHON_BIN="python"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required but was not found in PATH."
  exit 1
fi
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "Python was not found in PATH."
  exit 1
fi

# Re-run safely even when old dev servers are still listening.
echo "[1/6] Installing Python dependencies..."
"$PYTHON_BIN" -m pip install -r requirements.txt >/tmp/sih26012_pip.log 2>&1 || {
  echo "Dependency installation failed. See /tmp/sih26012_pip.log"
  exit 1
}

echo "[2/6] Starting PostGIS..."
docker compose up -d postgis >/tmp/sih26012_docker.log 2>&1 || {
  echo "Docker compose failed. See /tmp/sih26012_docker.log"
  exit 1
}
for _ in $(seq 1 60); do
  if docker ps --format '{{.Names}}' | grep -q 'sih26012-postgis'; then break; fi
  sleep 1
done
if ! docker ps --format '{{.Names}}' | grep -q 'sih26012-postgis'; then
  echo "PostGIS did not start successfully."
  exit 1
fi

echo "[3/6] Importing India boundary data (best effort)..."
if "$PYTHON_BIN" -m backend.postgis.import_india_admin >/tmp/sih26012_import.log 2>&1; then
  echo "Boundary import succeeded."
else
  echo "Boundary import failed; frontend can use its cached/remote fallback."
fi

echo "[4/6] Seeding Pune pilot + deterministic ALU catalog..."
"$PYTHON_BIN" -m backend.pune_demo.seed --reset >/tmp/sih26012_pune_seed.log 2>&1 || {
  echo "Pune demo/ALU seeding failed. See /tmp/sih26012_pune_seed.log"
  exit 1
}

echo "[5/6] Starting FastAPI backend..."
# Free ports used by previous runs, then start the API.
fuser -k 8000/tcp >/dev/null 2>&1 || true
nohup "$PYTHON_BIN" -m uvicorn backend.api.main:app --host 0.0.0.0 --port 8000 >/tmp/sih26012_backend.log 2>&1 &
for _ in $(seq 1 60); do
  if curl -fsS http://localhost:8000/health >/tmp/sih26012_backend_check.out 2>/dev/null; then break; fi
  sleep 1
done
if ! curl -fsS http://localhost:8000/health >/tmp/sih26012_backend_check.out 2>/dev/null; then
  echo "FastAPI did not start successfully. See /tmp/sih26012_backend.log"
  exit 1
fi

# Force-refresh the Pune catalog once after the API is live so the app can be
# started from a completely fresh Codespace without an extra command.
curl -fsS -X POST 'http://localhost:8000/api/v1/pune-demo/seed?reset=false' >/tmp/sih26012_pune_seed_check.out 2>/dev/null || true

echo "[6/6] Starting frontend server..."
fuser -k 3000/tcp >/dev/null 2>&1 || true
nohup "$PYTHON_BIN" serve_frontend.py --port 3000 >/tmp/sih26012_frontend.log 2>&1 &
for _ in $(seq 1 40); do
  if curl -fsSI http://localhost:3000/map.html >/tmp/sih26012_frontend_check.out 2>/dev/null; then break; fi
  sleep 1
done
if ! curl -fsSI http://localhost:3000/map.html >/tmp/sih26012_frontend_check.out 2>/dev/null; then
  echo "Frontend did not start successfully. See /tmp/sih26026012_frontend.log"
  exit 1
fi

cat <<EOF

Project started successfully.

India WebGIS:
  http://localhost:3000/

Pune Demo:
  http://localhost:3000/pune-demo/

API health:
  http://localhost:8000/health

Pune ALU catalog:
  10,000 × 1 m² ALUs
  100,000 × 0.1 m² logical terminal ALUs

Logs:
  /tmp/sih26012_backend.log
  /tmp/sih26012_frontend.log
  /tmp/sih26012_pune_seed.log

To stop later:
  pkill -f 'uvicorn backend.api.main:app' || true
  pkill -f 'serve_frontend.py' || true
EOF
